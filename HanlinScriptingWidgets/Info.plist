	<string>iCloud.com.itorah.chavrusachat</string>
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>ScriptWidget</key>
		<string>Your selected mini app uses precise location for the feature you requested.</string>
	</dict>
	<key>NSWidgetWantsLocation</key>
	<true/>
	<key>ScriptWidgetServiceKeychainGroup</key>
	<string>$(AppIdentifierPrefix)com.itorah.chavrusachat.scriptwidget.services</string>
	<key>HanlinExpoWidgetsProductIdentifier</key>
	<string>com.itorah.chavrusachat</string>

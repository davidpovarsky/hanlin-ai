{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "swift",
    "npm",
    "custom.regex"
  ],
  "dependencyDashboard": {
    "enabled": false
  },
  "automerge": false,
  "platformAutomerge": false,
  "rangeStrategy": "pin",
  "pinDigests": true,
  "branchPrefix": "codex/renovate/",
  "prConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "ignorePaths": [
    "**/node_modules/**",
    "**/.build/**",
    "Vendor/**",
    "Reference/**",
    "**/Resources/NativeScriptSharedRuntime/**",
    "**/Prepared/**",
    "**/Artifacts/**",
    "**/Tests/Fixtures/**",
    "**/Tests/DownstreamFixtures/**"
  ],
  "packageRules": [
    {
      "description": "NativeScript/Expo/compiler sets require their existing atomic ABI preparation",
      "matchFileNames": [
        "Scripts/NativeScript/**",
        "Scripts/Expo/**",
        "Scripts/ExpoNativeAPI/**",
        "Packages/HanlinExpo*/**",
        "Fixtures/**",
        "DemoMiniApps/**",
        "Scripts/ScriptingCompiler/**",
        "Packages/HanlinNativeScript*/**"
      ],
      "enabled": false
    },
    {
      "description": "Private SDK and toolchain source refs stay with their coherent source owner",
      "matchPackageNames": [
        "https://github.com/davidpovarsky/**",
        "https://github.com/swiftlang/swift-syntax",
        "https://github.com/apple/swift-syntax",
        "davidpovarsky/**",
        "swiftlang/swift-syntax",
        "apple/swift-syntax"
      ],
      "enabled": false
    },
    {
      "description": "Runtime host proposals are synchronized by the existing Runtime updater before acceptance",
      "matchFileNames": [
        "AI_HLY/Downstream/RuntimeCore/Node/Host/package.json"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "draftPR": true
    },
    {
      "description": "Native/binary/digest and major updates always need manual review",
      "matchUpdateTypes": [
        "major",
        "digest"
      ],
      "draftPR": true,
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Scripts/Runtime/upstream-sources\\.json$/"
      ],
      "matchStrings": [
        "\"repository\":\\s*\"(?<depName>https://github\\.com/[^\"]+)\",\\s*\"ref\":\\s*\"(?<currentValue>[^\"]+)\",\\s*\"revision\":\\s*\"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "git"
    }
  ]
}

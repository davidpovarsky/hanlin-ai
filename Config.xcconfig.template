// Configuration Template for API Keys
// Copy this file to Config.xcconfig and fill in your actual API keys
// This template file can be safely committed to git

HANLIN_API_KEY = YOUR_HANLIN_API_KEY_HERE
HANLIN_OPEN_API_KEY = YOUR_HANLIN_OPEN_API_KEY_HERE
HEADER_SEARCH_PATHS = $(inherited) "$(SRCROOT)/Packages/HanlinExpoRuntime/Artifacts/ReactModularHeaders" "$(SRCROOT)/Artifacts/ReactModularHeaders" "$(BUILT_PRODUCTS_DIR)/Python.framework/Headers"
WARNING_CFLAGS = $(inherited) -Wno-quoted-include-in-framework-header -Wno-non-modular-include-in-framework-module
OTHER_CFLAGS = $(inherited) -Wno-quoted-include-in-framework-header -Wno-non-modular-include-in-framework-module
OTHER_SWIFT_FLAGS = $(inherited) -Xcc -Wno-quoted-include-in-framework-header -Xcc -Wno-non-modular-include-in-framework-module

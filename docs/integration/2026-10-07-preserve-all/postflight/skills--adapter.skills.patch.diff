+ */
+- (void)unmountChildComponentView:(nonnull UIView *)childComponentView index:(NSInteger)index;
+
+@end`
+        );
+        writeFileSync(full, content, 'utf8');
+        console.log('Sanitized ExpoFabricViewObjC.h at:', full);
+      }
+    } else if (ent.name === 'EXHostWrapper.h') {

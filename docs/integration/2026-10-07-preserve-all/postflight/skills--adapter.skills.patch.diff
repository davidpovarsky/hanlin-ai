+#if __has_include(<folly/dynamic.h>)
+#include <folly/dynamic.h>
+#elif __has_include("folly/dynamic.h")
+#include "folly/dynamic.h"
+#elif __has_include("../dynamic.h")
+#include "../dynamic.h"
+#endif

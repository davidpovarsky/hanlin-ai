+  if (existsSync(fullTarget)) {
+    console.log('[HanlinExpo] Scanning and patching hash_combine.h in:', fullTarget);
+    patchAll(fullTarget);
+  }
+}
+console.log('Done scanning and patching hash_combine.h');

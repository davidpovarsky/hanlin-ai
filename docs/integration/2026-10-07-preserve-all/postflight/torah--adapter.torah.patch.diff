+import hashlib
+
+def make_fixture(
+    fid,
+    title,
+    acquisition,
+    script_cat,
+    split,
+    outcome,
+    raw_text,
+    allowed_locators,
+    role="primary_work",
+    is_neg=False,
+    warnings=[]
+):
+    h = hashlib.sha256(f"{fid}_{raw_text}".encode("utf-8")).hexdigest()
+    return {
+        "fixtureID": fid,
+        "title": title,
+        "imageSHA256": h,

+        let link = TorahStudyDeepLink(action: .open, locator: locator, workTitle: identifiedBookTitle, highlightText: ocrText)
+        guard let url = link.url(scheme: "maktabah") else { return }
+        #if canImport(UIKit)
+        UIApplication.shared.open(url)
+        #endif
+    }
+}

+                    if let top = result.selectedCandidate {
+                        identifiedBookTitle = top.workTitle
+                        identifiedLocator = top.locator.persistenceKey
+                        identificationStatus = result.status == .verified ? "מאומת" : "זוהה (סבירות נמוכה/חלופית)"
+                    } else {

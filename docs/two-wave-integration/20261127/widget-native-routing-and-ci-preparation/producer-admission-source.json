          "shell": "bash",
          "run": "set -euo pipefail\nsplit_phase_start=$SECONDS\ntrap 'printf \"%s\\n\" \"$(( SECONDS - split_phase_start ))\" > \"$SPLIT_EVIDENCE/native-dependencies-duration-seconds.txt\"' EXIT\n{\nnode Scripts/MiniApps/install-tooling.mjs --engine=nativescript --ignore-scripts\nnpm run prepare:ios-dependencies --prefix Scripts/NativeScript\nnode Scripts/MiniApps/install-tooling.mjs --engine=expo --ignore-scripts\nnode Scripts/Expo/prepare-ios-dependencies.mjs\nnode Scripts/Expo/prepare-types.mjs\nnode Scripts/Expo/build-probe.mjs\nnode Scripts/ExpoNativeAPI/build-probes.mjs\nbash Scripts/Runtime/prepare-runtime-core.sh\nbash Scripts/Runtime/prepare-runtime-host.sh\ncp build/runtime-host/RuntimeHostResources.zip AI_HLY/RuntimeHostResources.zip\n# Check the actual public guide blocks against the exact SDK in the verified shipping ZIP.\n# Static authoring checks do not imply a MiniApp launched or a native service executed.\nnode Scripts/MiniApps/check-authoring-examples.mjs --sdk-archive build/runtime-host/RuntimeHostResources.zip --require-sdk-docs --report \"$SPLIT_EVIDENCE/miniapp-documentation-snippets.json\"\n# The verified ZIP above is the shipping payload. The lifecycle check's\n# temporary npm tree must not enter Xcode's synchronized app resources.\nrm -rf AI_HLY/Downstream/RuntimeCore/Node/Host/node_modules\ntest ! -e AI_HLY/Downstream/RuntimeCore/Node/Host/node_modules\ncat > Config.xcconfig <<'EOF'\nSWIFT_ENABLE_EXPLICIT_MODULES = NO\nSWIFT_OBJC_INTEROP_MODE = objcxx\nCLANG_CXX_LANGUAGE_STANDARD = gnu++20\nCLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES\nCLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO\nEOF\n} 2>&1 | tee \"$SPLIT_EVIDENCE/native-dependencies.log\"\n"

+        })
+        #expect(handle.readPositionAfterLayout(conversationID: conversationID) { _ in
+            staleCalls += 1
+        } == nil)
+        await replaced.value
+        await current.value
+        #expect(staleCalls == 0 && currentCalls == 1)

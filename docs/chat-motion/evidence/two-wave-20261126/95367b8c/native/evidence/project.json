{
  "name": "ChatMotionProof",
  "options": {
    "deploymentTarget": {
      "iOS": "27.0"
    }
  },
  "settings": {
    "base": {
      "GENERATE_INFOPLIST_FILE": "YES",
      "SWIFT_VERSION": "6.0",
      "CODE_SIGNING_ALLOWED": "NO",
      "TARGETED_DEVICE_FAMILY": "1,2",
      "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES"
    }
  },
  "packages": {
    "HanlinSDK": {
      "path": "Vendor/HanlinSDK"
    }
  },
  "targets": {
    "ChatMotionProof": {
      "type": "application",
      "platform": "iOS",
      "sources": [
        "App"
      ],
      "dependencies": [
        {
          "package": "HanlinSDK",
          "product": "HanlinChatUI"
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "ai.hanlin.motion-proof",
          "ASSETCATALOG_COMPILER_APPICON_NAME": "",
          "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
          "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
          "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight"
        }
      }
    },
    "ChatMotionProofUITests": {
      "type": "bundle.ui-testing",
      "platform": "iOS",
      "sources": [
        "UITests"
      ],
      "dependencies": [
        {
          "target": "ChatMotionProof"
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "ai.hanlin.motion-proof.uitests",
          "TEST_TARGET_NAME": "ChatMotionProof"
        }
      }
    }
  },
  "schemes": {
    "ChatMotionProof": {
      "build": {
        "targets": {
          "ChatMotionProof": "all"
        }
      },
      "test": {
        "targets": [
          "ChatMotionProofUITests"
        ]
      }
    }
  }
}

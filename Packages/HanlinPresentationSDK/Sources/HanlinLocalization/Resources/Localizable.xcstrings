          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשך מהנקודה שבה התשובה נעצרה. שמור על התשובה הקודמת ואל תחזור על פעולות או קריאות כלים שכבר הושלמו."
          }

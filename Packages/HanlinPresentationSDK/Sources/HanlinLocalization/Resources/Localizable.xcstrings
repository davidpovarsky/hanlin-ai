        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החבילה המקורית והדוח נשלחים יחד. Hanlin AI פותח שיחה ייעודית לתיקון ויכול לבנות, לבדוק ולהחזיר את החבילה המתוקנת."
          }
        }
      }
    },

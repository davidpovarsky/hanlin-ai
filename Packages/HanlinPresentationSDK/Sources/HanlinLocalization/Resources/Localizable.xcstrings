    "TypeScript validation has not run because a complete authoring project was not recognized. Package compatibility was inspected. If only compiled JavaScript is available, original TypeScript types cannot be reconstructed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TypeScript validation has not run because a complete authoring project was not recognized. Package compatibility was inspected. If only compiled JavaScript is available, original TypeScript types cannot be reconstructed."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא בוצעה בדיקת טיפוסי TypeScript, כי לא זוהה פרויקט מקור מלא. נבדקה תאימות החבילה. אם זמין רק קוד JavaScript שכבר קומפל, אי אפשר לשחזר ממנו את טיפוסי TypeScript המקוריים."
          }
        }
      }
    },
    "TypeScript validation has not run. The original package is kept with the import diagnostic.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TypeScript validation has not run. The original package is kept with the import diagnostic."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדיקת טיפוסי TypeScript טרם הורצה. החבילה המקורית נשמרה יחד עם שגיאת הייבוא."
          }
        }
      }
    },

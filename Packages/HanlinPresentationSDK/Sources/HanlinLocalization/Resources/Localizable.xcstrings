            "value": "开始对话"
          }
        }
      }
    },
    "Open Profile, then Models to configure a provider and select a chat model. A text optimization model is optional for ordinary conversations.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Profile, then Models to configure a provider and select a chat model. A text optimization model is optional for ordinary conversations."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את הפרופיל ואז את המודלים כדי להגדיר ספק ולבחור מודל לשיחה. מודל לשיפור טקסט הוא אפשרות ואינו נדרש לשיחה רגילה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开个人资料中的模型，配置服务商并选择聊天模型。普通对话不需要设置文本优化模型。"
          }
        }
      }
    },
    "Chat and history": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat and history"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שיחות והיסטוריה"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话与历史"
          }
        }
      }
    },
    "Use Chat to create or reopen a conversation. History keeps the original conversation and its messages. Use the workspace menu for Vision or the separate MiniApps app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Chat to create or reopen a conversation. History keeps the original conversation and its messages. Use the workspace menu for Vision or the separate MiniApps app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במסך השיחות אפשר ליצור שיחה או לפתוח שיחה קיימת. ההיסטוריה שומרת את השיחה המקורית וההודעות שלה. בתפריט סביבת העבודה נמצאים Vision והאפליקציה הנפרדת MiniApps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在聊天中创建或重新打开对话。历史记录保留原始对话和消息。通过工作区菜单打开视觉功能或独立的 MiniApps 应用。"
          }
        }
      }
    },
    "Your library": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספרייה שלכם"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的资料库"
          }
        }
      }
    },
    "Library contains knowledge, memory, prompts, canvases and saved messages. Opening an item uses its original editor or reader.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Library contains knowledge, memory, prompts, canvases and saved messages. Opening an item uses its original editor or reader."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספרייה כוללת ידע, זיכרונות, פרומפטים, מסמכי Canvas והודעות שמורות. כל פריט נפתח בעורך או בקורא המקורי שלו."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料库包含知识、记忆、提示词、画布和收藏消息。项目会在其原有编辑器或阅读器中打开。"
          }
        }
      }
    },
    "Skills and MiniApps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills and MiniApps"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills ו־MiniApps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "技能与 MiniApps"
          }
        }
      }
    },
    "Use Profile, then Skill Center to review and import skills. Check the skill files, runtime requirements and requested actions before running them. MiniApps opens the separately installed companion; it must be installed to handle a request.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Profile, then Skill Center to review and import skills. Check the skill files, runtime requirements and requested actions before running them. MiniApps opens the separately installed companion; it must be installed to handle a request."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בפרופיל, פתחו את מרכז ה־Skills כדי לבדוק ולייבא Skills. לפני ההרצה בדקו את הקבצים, דרישות סביבת ההרצה והפעולות המבוקשות. MiniApps פותח את האפליקציה הנלווית, שצריכה להיות מותקנת כדי לטפל בבקשה."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过个人资料中的技能中心查看和导入技能。运行前检查技能文件、运行环境要求和请求的操作。MiniApps 会打开独立安装的配套应用，处理请求前必须先安装它。"
          }
        }
      }
    },
    "Message actions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message actions"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולות על הודעות"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息操作"
          }
        }
      }
    },
    "Use a message's Select action to select text, copy it, or open Translation, Polish or Summary with that text. Those writing tools require their configured model. A Python canvas can use the on-device runtime or an explicitly selected remote service.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a message's Select action to select text, copy it, or open Translation, Polish or Summary with that text. Those writing tools require their configured model. A Python canvas can use the on-device runtime or an explicitly selected remote service."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולת הבחירה בהודעה מאפשרת לבחור טקסט, להעתיקו או לפתוח אותו בתרגום, בשיפור ניסוח או בסיכום. כלים אלה דורשים מודל מוגדר. Canvas של Python יכול להשתמש בסביבת ההרצה במכשיר או בשירות מרוחק שנבחר במפורש."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用消息的选择操作来选择、复制文本，或将文本交给翻译、润色或摘要。这些写作工具需要配置相应模型。Python 画布可以使用设备内运行环境，或明确选择的远程服务。"
          }
        }
      }
    },
    "Keep your data": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your data"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמירה על הנתונים"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存数据"
          }
        }
      }
    },
    "Conversations and library items use the app's existing storage. Back up important content before migrating or reinstalling. MiniApps transfer previews identify the data being transferred; inspect the result before removing the original.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations and library items use the app's existing storage. Back up important content before migrating or reinstalling. MiniApps transfer previews identify the data being transferred; inspect the result before removing the original."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השיחות ופריטי הספרייה נשמרים באחסון של האפליקציה. גבו תוכן חשוב לפני העברה או התקנה מחדש. תצוגת ההעברה של MiniApps מפרטת את הנתונים שיועברו; בדקו את התוצאה לפני מחיקת המקור."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话和资料库项目使用应用现有的存储。迁移或重新安装前请备份重要内容。MiniApps 传输预览会列出待传输的数据；删除原始数据前请检查结果。"
          }
        }
      }
    },
    "Cloud model costs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud model costs"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עלויות מודלים בענן"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端模型费用"
          }
        }
      }
    },
    "Cloud providers bill under your own account and pricing. A request may include conversation history, attachments, tool results and generated output. Check the selected provider's current rates and usage dashboard.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud providers bill under your own account and pricing. A request may include conversation history, attachments, tool results and generated output. Check the selected provider's current rates and usage dashboard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספקי הענן מחייבים לפי החשבון והתעריפים שלכם. בקשה עשויה לכלול היסטוריית שיחה, קבצים מצורפים, תוצאות כלים ופלט שנוצר. בדקו את התעריפים העדכניים ואת לוח השימוש אצל הספק שנבחר."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端服务商按你的账户和资费计费。请求可能包含对话历史、附件、工具结果和生成的输出。请查看所选服务商的最新价格和用量面板。"
          }
        }
      }
    },
    "Tools and external services": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools and external services"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כלים ושירותים חיצוניים"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具与外部服务"
          }
        }
      }
    },
    "Search, media, remote code execution and other connected services can have separate limits or charges. A model subscription does not automatically include these services. Review the destination before sending data.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search, media, remote code execution and other connected services can have separate limits or charges. A model subscription does not automatically include these services. Review the destination before sending data."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחיפוש, למדיה, להרצת קוד מרחוק ולשירותים מחוברים אחרים עשויות להיות מכסות או עלויות נפרדות. מנוי למודל אינו כולל אותם באופן אוטומטי. בדקו את היעד לפני שליחת נתונים."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索、媒体、远程代码执行及其他连接服务可能有独立的限制或费用。模型订阅不会自动包含这些服务。发送数据前请确认目标服务。"
          }
        }
      }
    },
    "On-device execution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device execution"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרצה במכשיר"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备内执行"
          }
        }
      }
    },
    "Local Python runs through Hanlin's embedded runtime without calling a cloud model for that execution. It uses device resources. A script can still call a service itself, and an AI conversation that writes or runs the script can incur model charges.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local Python runs through Hanlin's embedded runtime without calling a cloud model for that execution. It uses device resources. A script can still call a service itself, and an AI conversation that writes or runs the script can incur model charges."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Python מקומי פועל בסביבת ההרצה המובנית של Hanlin, ללא קריאה למודל ענן לצורך ההרצה עצמה, וצורך משאבי מכשיר. הסקריפט עדיין יכול לפנות בעצמו לשירות חיצוני, ושיחת AI שכותבת או מריצה אותו עשויה לגרור חיובי מודל."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 Python 通过 Hanlin 内置环境执行，该次执行不会调用云端模型，但会使用设备资源。脚本自身仍可能访问外部服务，编写或运行脚本的 AI 对话也可能产生模型费用。"
          }
        }
      }
    },
    "Check actual usage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check actual usage"
          }
        },

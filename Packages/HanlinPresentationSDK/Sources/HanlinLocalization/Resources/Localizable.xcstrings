    "The current model \"%@\" does not support tool calling. You can still browse and manage skills and MCP." : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current model \"%@\" does not support tool calling. You can still browse and manage skills and MCP."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המודל הנוכחי ״%@״ אינו תומך בשימוש בכלים. עדיין אפשר לעיין במיומנויות ובשרתי MCP ולנהל אותם."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前模型“%@”不支持工具调用。你仍可浏览和管理技能及 MCP。"
          }
        }
      }
    },

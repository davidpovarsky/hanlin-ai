    "Choose an installed instance. Placements using the same instance share state.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an installed instance. Placements using the same instance share state."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו מופע מותקן. מיקומים המשתמשים באותו מופע חולקים מצב."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个已安装的实例。使用同一实例的位置共享状态。"
          }
        }
      }
    },
    "Open Hanlin Camera": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Hanlin Camera"
          }

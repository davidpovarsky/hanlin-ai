          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Hanlin 相机"
          }
        }
      }
    },
    "Opens Hanlin’s camera and visual analysis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Hanlin’s camera and visual analysis."

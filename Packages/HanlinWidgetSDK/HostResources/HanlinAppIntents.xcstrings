    "Configuration (JSON)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration (JSON)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרות (JSON)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置（JSON）"
          }
        }
      }

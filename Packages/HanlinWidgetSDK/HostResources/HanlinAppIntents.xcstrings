        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפעיל פעולה מחבילת Hanlin Script מותקנת."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行已安装的 Hanlin Script 软件包中的操作。"
          }
        }
      }
    },

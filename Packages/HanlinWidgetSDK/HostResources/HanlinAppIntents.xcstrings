    "Choose an installed instance. Placements using the same instance share state.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an installed instance. Placements using the same instance share state."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו מופע מותקן. מיקומים המשתמשים באותו מופע חולקים מצב."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个已安装的实例。使用同一实例的位置共享状态。"
          }
        }
      }
    },
    "Open Hanlin Camera": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Hanlin Camera"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתיחת מצלמת Hanlin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Hanlin 相机"
          }
        }
      }
    },
    "Opens Hanlin’s camera and visual analysis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Hanlin’s camera and visual analysis."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח את המצלמה ואת הניתוח החזותי של Hanlin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Hanlin 相机和视觉分析。"
          }
        }
      }
    },
    "Enable Hanlin Notifications": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Hanlin Notifications"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעלת התראות Hanlin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用 Hanlin 通知"
          }
        }
      }
    },
    "Enables notifications for Hanlin after you grant system permission.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enables notifications for Hanlin after you grant system permission."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפעיל התראות עבור Hanlin לאחר מתן הרשאה במערכת."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您授予系统权限后启用 Hanlin 通知。"
          }
        }
      }
    },
    "Schedule an Alarm with Hanlin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schedule an Alarm with Hanlin"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תזמון שעון מעורר ב־Hanlin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Hanlin 设置闹钟"
          }
        }
      }
    },
    "Schedules a system alarm at the time you choose.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schedules a system alarm at the time you choose."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתזמן שעון מעורר במערכת לשעה שתבחרו."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您选择的时间设置系统闹钟。"
          }
        }
      }
    },

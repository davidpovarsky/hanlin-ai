    "Waits for an existing MiniApp action and returns its text or JSON result without running it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waits for an existing MiniApp action and returns its text or JSON result without running it again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממתינה לפעולה קיימת של מיני־אפליקציה ומחזירה את תוצאתה כטקסט או JSON בלי להפעיל אותה שוב."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待现有迷你应用操作完成并返回其文本或 JSON 结果，不会再次运行该操作。"
          }
        }
      }
    },

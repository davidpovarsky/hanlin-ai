    "Choose a widget registered by an installed MiniApp using the original Expo Widgets API.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a widget registered by an installed MiniApp using the original Expo Widgets API."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו וידג׳ט שמיני־אפליקציה מותקנת רשמה באמצעות ה־API המקורי של Expo Widgets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择已安装的迷你应用通过原生 Expo Widgets API 注册的小组件。"
          }
        }
      }
    },
    "Widget option": {
      "extractionState": "manual",
      "localizations": {

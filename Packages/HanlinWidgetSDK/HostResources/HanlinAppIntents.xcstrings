        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתזמן שעון מעורר במערכת לשעה שתבחרו."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您选择的时间设置系统闹钟。"
          }
        }
      }
    },

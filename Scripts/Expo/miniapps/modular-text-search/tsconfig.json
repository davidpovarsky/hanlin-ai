{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "types": [
      "react",
      "react-native"
    ]
  },
  "include": [
    "*.ts",
    "*.tsx"
  ],
  "exclude": [
    "native"
  ]
}

{
  "name": "חיפוש טקסטים מודולרי — Expo",
  "version": "1.3.0",
  "description": "Native SwiftUI text search with Expo, Share, Shortcuts and Translation continuation.",
  "entry": "bundle.js",
  "runInApp": true,
  "hanlinRuntime": "hanlin-expo",
  "author": {
    "name": "david povarsky"
  },
  "icon": "magnifyingglass",
  "color": "#007AFF",
  "capabilities": [
    "ios-native-api",
    "network",
    "inter-app.share"
  ],
  "entrypoints": [
    {
      "id": "appIntents",
      "kind": "appIntent",
      "sourcePath": "bundle.js",
      "exportedSymbol": "search"
    },
    {
      "id": "share",
      "kind": "share",
      "sourcePath": "bundle.js",
      "exportedSymbol": "search"
    },
    {
      "id": "translation",
      "kind": "translationUI",
      "sourcePath": "bundle.js",
      "exportedSymbol": "search"
    }
  ],
  "actions": [
    {
      "id": "search",
      "title": "חיפוש טקסטים",
      "handler": "bundle.js",
      "capability": "inter-app.share"
    }
  ],
  "intentInputTypes": [
    "Text",
    "URLs"
  ]
}

{
  "name": "חיפוש טקסטים מודולרי — Expo",
  "version": "1.4.0",
  "description": "Original native Expo search app, Share, interactive native Shortcuts snippets and editable Translation UI with original ScriptWidget services.",
  "entry": "bundle.js",
  "runInApp": true,
  "hanlinRuntime": "hanlin-expo",
  "author": {
    "name": "david povarsky"
  },
  "icon": "magnifyingglass",
  "color": "#007AFF",
  "capabilities": [
    "ios-native-api",
    "network",
    "inter-app.share"
  ],
  "entrypoints": [
    {
      "id": "appIntents",
      "kind": "appIntent",
      "sourcePath": "bundle.js",
      "exportedSymbol": "search"
    },
    {
      "id": "share",
      "kind": "share",
      "sourcePath": "bundle.js",
      "exportedSymbol": "search"
    },
    {
      "id": "translation",
      "kind": "translationUI",
      "sourcePath": "bundle.js",
      "exportedSymbol": "search"
    }
  ],
  "actions": [
    {
      "id": "search",
      "title": "חיפוש טקסטים",
      "handler": "bundle.js",
      "capability": "inter-app.share"
    }
  ],
  "intentInputTypes": [
    "Text",
    "URLs"
  ],
  "nativePresentations": {
    "appIntents": {
      "engine": "scriptwidget",
      "sourcePath": "native/search.tsx",
      "sourceFormat": "tsx",
      "actions": [
        {
          "id": "retry",
          "kind": "function",
          "handler": "retry"
        },
        {
          "id": "toggleVersions",
          "kind": "function",
          "handler": "toggleVersions"
        },
        {
          "id": "loadFullText",
          "kind": "function",
          "handler": "loadFullText"
        },
        {
          "id": "closeFullText",
          "kind": "function",
          "handler": "closeFullText"
        },
        {
          "id": "loadMore",
          "kind": "function",
          "handler": "loadMore"
        },
        {
          "id": "replaceText",
          "kind": "function",
          "handler": "replaceText"
        }
      ]
    },
    "translation": {
      "engine": "scriptwidget",
      "sourcePath": "native/search.tsx",
      "sourceFormat": "tsx",
      "actions": [
        {
          "id": "retry",
          "kind": "function",
          "handler": "retry"
        },
        {
          "id": "toggleVersions",
          "kind": "function",
          "handler": "toggleVersions"
        },
        {
          "id": "loadFullText",
          "kind": "function",
          "handler": "loadFullText"
        },
        {
          "id": "closeFullText",
          "kind": "function",
          "handler": "closeFullText"
        },
        {
          "id": "loadMore",
          "kind": "function",
          "handler": "loadMore"
        },
        {
          "id": "replaceText",
          "kind": "function",
          "handler": "replaceText"
        }
      ],
      "input": {
        "title": "טקסט לחיפוש",
        "placeholder": "כתוב מילה או משפט",
        "submitTitle": "חפש מחדש"
      }
    }
  }
}

{
  "name": "Surface Expo",
  "version": "1.0.0",
  "description": "Dedicated real system-surface proof: current installed action, fresh private challenge/state, and complete real receipts from all five Host runtimes.",
  "hanlinAppID": "hanlin.surface.expo",
  "entry": "bundle.js",
  "runInApp": true,
  "hanlinRuntime": "hanlin-expo",
  "widgetEngine": "expo",
  "icon": "hand.tap",
  "color": "#2455B2",
  "capabilities": [
    "storage",
    "node",
    "python",
    "javascript",
    "inter-app.share",
    "live-activity"
  ],
  "actions": [
    {
      "id": "surface.run",
      "title": "Run Surface Expo in all five runtimes",
      "handler": "bundle.js",
      "capability": "inter-app.share"
    }
  ],
  "entrypoints": [
    {
      "id": "surface-intent",
      "kind": "appIntent",
      "sourcePath": "bundle.js",
      "exportedSymbol": "surface.run"
    },
    {
      "id": "surface-share",
      "kind": "share",
      "sourcePath": "bundle.js",
      "exportedSymbol": "surface.run"
    },
    {
      "id": "surface-translation",
      "kind": "translationUI",
      "sourcePath": "bundle.js",
      "exportedSymbol": "surface.run"
    }
  ],
  "intentInputTypes": [
    "Text",
    "URLs"
  ],
  "hanlinWidget": {
    "abiVersion": 1,
    "sourceFormat": "expo-layout",
    "families": [
      "systemSmall",
      "systemMedium",
      "systemLarge"
    ],
    "actions": [
      {
        "id": "surface-host-run",
        "kind": "hostAction",
        "hostAction": {
          "entrypointID": "surface-intent",
          "actionName": "surface.run",
          "parameters": {
            "surface": "widget",
            "fixture": "hanlin.surface.expo"
          }
        }
      }
    ]
  }
}

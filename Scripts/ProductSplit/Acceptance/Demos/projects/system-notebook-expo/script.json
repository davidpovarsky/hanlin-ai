{
  "name": "מחברת המערכת — Expo",
  "version": "1.0.0",
  "description": "דוגמה מעשית נפרדת: Spotlight, צילום ממשי, מקלדת מקורית והתראה עשירה עם המשך פעולה.",
  "hanlinAppID": "hanlin.demo.system.expo",
  "entry": "bundle.js",
  "runInApp": true,
  "hanlinRuntime": "hanlin-expo",
  "icon": "note.text",
  "color": "#2563EB",
  "capabilities": [
    "storage",
    "inter-app.share",
    "ios-native-api"
  ],
  "keywords": [
    "מחברת",
    "צילום",
    "מקלדת",
    "Spotlight"
  ],
  "actions": [
    {
      "id": "spotlight.open",
      "title": "פתיחת מחברת מחיפוש",
      "handler": "bundle.js",
      "capability": "inter-app.share"
    },
    {
      "id": "capture.receive",
      "title": "קבלת הצילומים שנשמרו",
      "handler": "bundle.js",
      "capability": "inter-app.share"
    },
    {
      "id": "notification.open",
      "title": "המשך מתוך ההתראה",
      "handler": "bundle.js",
      "capability": "inter-app.share"
    }
  ],
  "entrypoints": [
    {
      "id": "search",
      "kind": "spotlight",
      "sourcePath": "bundle.js",
      "exportedSymbol": "spotlight.open"
    },
    {
      "id": "photo",
      "kind": "capture",
      "sourcePath": "bundle.js",
      "exportedSymbol": "capture.receive"
    },
    {
      "id": "keys",
      "kind": "keyboard",
      "sourcePath": "bundle.js"
    },
    {
      "id": "notice",
      "kind": "notificationUI",
      "sourcePath": "bundle.js"
    },
    {
      "id": "notice-action",
      "kind": "appIntent",
      "sourcePath": "bundle.js",
      "exportedSymbol": "notification.open"
    }
  ],
  "nativePresentations": {
    "keys": {
      "engine": "scriptwidget",
      "sourcePath": "native/keyboard.tsx",
      "sourceFormat": "tsx",
      "actions": [
        {
          "id": "keys.greeting",
          "kind": "function",
          "handler": "insertGreeting"
        },
        {
          "id": "keys.thanks",
          "kind": "function",
          "handler": "insertThanks"
        },
        {
          "id": "keys.delete",
          "kind": "function",
          "handler": "deleteLast"
        },
        {
          "id": "keys.left",
          "kind": "function",
          "handler": "moveCursorLeft"
        },
        {
          "id": "keys.next",
          "kind": "function",
          "handler": "nextKeyboard"
        }
      ]
    },
    "notice": {
      "engine": "scriptwidget",
      "sourcePath": "native/notification.tsx",
      "sourceFormat": "tsx",
      "actions": [
        {
          "id": "notice.open",
          "kind": "function",
          "handler": "continueInApp"
        },
        {
          "id": "notice.dismiss",
          "kind": "function",
          "handler": "dismissNotice"
        }
      ]
    }
  }
}

{
  "compilerOptions": {
    "allowJs": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@hanlin/expo-ui": ["../../Packages/HanlinExpoUI/src/index.ts"],
      "@hanlin/expo-ui/*": ["../../Packages/HanlinExpoUI/src/*"],
      "react": ["../../Scripts/Expo/node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["../../Scripts/Expo/node_modules/@types/react/jsx-runtime.d.ts"],
      "react/jsx-dev-runtime": ["../../Scripts/Expo/node_modules/@types/react/jsx-dev-runtime.d.ts"],
      "react-native": ["../../Scripts/Expo/node_modules/react-native/types_generated/index.d.ts"],
      "*": ["../../Scripts/Expo/node_modules/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": ["*.ts", "*.tsx", "../../Packages/HanlinExpoUI/src/**/*.ts", "../../Packages/HanlinExpoUI/src/**/*.tsx"]
}
